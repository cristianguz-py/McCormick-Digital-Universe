# Copia este archivo a .env y completa los valores reales.
# NUNCA subas tu .env real a git.

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# --- Base de datos MySQL ---
DATABASE_NAME=mccormick_db
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# --- Contacto centralizado (requisito #37) ---
CONTACT_PHONE=+57 XXX XXX XXXX

# --- Contraseñas iniciales del seed (opcional: si no se definen, se usan
#     las contraseñas de desarrollo indicadas en accounts/management/commands/seed.py) ---
SEED_PASSWORD_MACO=
SEED_PASSWORD_IAN=
SEED_PASSWORD_MELANIE=
SEED_PASSWORD_CRISTIAN=

# --- Producción (opcional) ---
SECURE_SSL_REDIRECT=True
